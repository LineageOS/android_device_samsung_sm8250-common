<manifest version="2.0" type="device">
    <hal format="hidl">
        <name>android.hardware.secure_element</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>ISecureElement</name>
            <instance>eSE1</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>android.hardware.tetheroffload.config</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>IOffloadConfig</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>android.hardware.tetheroffload.control</name>
        <transport>hwbinder</transport>
        <version>1.1</version>
        <interface>
            <name>IOffloadControl</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl">
        <name>vendor.samsung.hardware.radio.channel</name>
        <version>1</version>
        <interface>
            <name>ISehRadioChannel</name>
            <instance>imsd</instance>
            <instance>imsd2</instance>
            <instance>epdgd</instance>
            <instance>epdgd2</instance>
        </interface>
    </hal>
    <hal format="aidl">
        <name>vendor.samsung.hardware.radio.network</name>
        <version>1</version>
        <interface>
            <name>ISehRadioNetwork</name>
            <instance>slot1</instance>
            <instance>slot2</instance>
        </interface>
    </hal>
</manifest>
