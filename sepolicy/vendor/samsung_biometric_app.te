# Display
allow samsung_biometric_app vendor_sysfs_graphics:dir r_dir_perms;
allow samsung_biometric_app vendor_sysfs_graphics:lnk_file r_file_perms;
allow samsung_biometric_app vendor_sysfs_graphics:file r_file_perms;

# Fingerprint
allow samsung_biometric_app hal_samsung_fingerprint_service:service_manager find;
binder_call(samsung_biometric_app, hal_fingerprint_default)
